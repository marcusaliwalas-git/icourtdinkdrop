# Copy to .env.local and fill in from `supabase status` after `supabase start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only by the Vitest DB-level tests (bypasses RLS by design).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public base URL of the site, used to build absolute links in emails. Set to the real
# custom domain in production (e.g. https://icourt.dinkdrop.live). Falls back to Vercel's
# per-deployment URL, then to http://localhost:3000, when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (email confirmations). Leave RESEND_API_KEY blank in local dev — LOCAL_SMTP_URL
# below routes booking emails to the local Mailpit inbox (http://127.0.0.1:54324) instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@example.com
LOCAL_SMTP_URL=smtp://127.0.0.1:54325

# Google OAuth (configured in supabase/config.toml [auth.external.google] + Supabase dashboard for hosted)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
